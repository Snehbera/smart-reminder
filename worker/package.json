{
  "name": "smart-reminder-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:wrangler": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings test/logic.test.mjs",
    "vapid": "node scripts/generate-vapid.mjs",
    "db:local": "wrangler d1 execute smart-reminder-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute smart-reminder-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "~5.6.3",
    "wrangler": "^4.0.0"
  }
}
